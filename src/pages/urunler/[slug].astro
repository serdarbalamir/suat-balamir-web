---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChartHydrator from '../../components/ChartHydrator.astro';
import ProductCard from '../../components/ProductCard.astro';
import site from '../../data/site.json';

export async function getStaticPaths() {
  const products = await getCollection('urunler', ({ data }) => !data.draft);
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { Content } = await render(product);
const d = product.data;

const all = await getCollection('urunler', ({ data }) => !data.draft);
const related = all
  .filter((p) => p.id !== product.id && p.data.kategori === d.kategori)
  .slice(0, 3);

const productSchema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.title,
  description: d.description,
  category: d.kategori,
  ...(d.image ? { image: new URL(d.image, Astro.site).href } : {}),
  brand: { '@type': 'Organization', name: site.organization.name },
};
---

<BaseLayout title={d.title} description={d.description} ogImage={d.image} schema={productSchema}>
  <div class="page-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="breadcrumb">
        <a href="/">Ana Sayfa</a> <span>/</span>
        <a href="/urunler">Ürünler</a> <span>/</span>
        <span>{d.kategori}</span>
      </nav>
      <h1>{d.title}</h1>
      <p>{d.description}</p>
    </div>
  </div>

  <div class="container">
    <div class="product-hero">
      <div>
        <div class="product-img-main">
          {d.image ? (
            <img src={d.image} alt={d.title} />
          ) : (
            <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2">
              <rect x="3" y="8" width="18" height="12" rx="1.5" />
              <path d="M7 8V5.5A1.5 1.5 0 0 1 8.5 4h7A1.5 1.5 0 0 1 17 5.5V8M3 13h18" />
            </svg>
          )}
        </div>
        {d.gallery.length > 0 && (
          <div style="display:grid;grid-template-columns:repeat(4,1fr);gap:10px;margin-top:12px;">
            {d.gallery.map((g) => (
              <a href={g} target="_blank" style="aspect-ratio:1;border:1px solid var(--gray-200);border-radius:6px;overflow:hidden;">
                <img src={g} alt={d.title} style="width:100%;height:100%;object-fit:cover;" loading="lazy" />
              </a>
            ))}
          </div>
        )}
      </div>

      <div>
        {d.specs.length > 0 && (
          <>
            <h2 style="font-size:1.25rem;margin-bottom:12px;">Teknik Özellikler</h2>
            <table class="spec-table">
              <tbody>
                {d.specs.map((s) => (
                  <tr>
                    <th>{s.name}</th>
                    <td>{s.value}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )}

        {d.standartlar.length > 0 && (
          <div style="margin:18px 0;">
            <h3 style="font-size:0.85rem;text-transform:uppercase;letter-spacing:0.06em;color:var(--gray-500);margin-bottom:10px;">İlgili Standartlar</h3>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {d.standartlar.map((s) => <span class="badge-standard">{s}</span>)}
            </div>
          </div>
        )}

        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:24px;">
          <a href={`/iletisim?konu=${encodeURIComponent(d.title)}`} class="btn btn-primary">
            Ürün Hakkında Bilgi Al
          </a>
          {d.brochure && (
            <a href={d.brochure} class="btn btn-outline" download>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
              </svg>
              Broşür İndir
            </a>
          )}
        </div>
      </div>
    </div>

    <div class="grid grid-2" style="padding-bottom:56px;align-items:start;">
      <div>
        {d.applications.length > 0 && (
          <>
            <h2 style="font-size:1.25rem;margin-bottom:14px;">Kullanım Alanları</h2>
            <ul class="check-list">
              {d.applications.map((a) => <li>{a}</li>)}
            </ul>
          </>
        )}
      </div>
      <div>
        {d.benefits.length > 0 && (
          <>
            <h2 style="font-size:1.25rem;margin-bottom:14px;">Faydalar</h2>
            <ul class="check-list">
              {d.benefits.map((b) => <li>{b}</li>)}
            </ul>
          </>
        )}
      </div>
    </div>

    <div class="prose" style="max-width:var(--content-width);padding-bottom:56px;">
      <Content />
    </div>

    {d.downloads.length > 0 && (
      <div style="padding-bottom:56px;">
        <h2 style="font-size:1.25rem;margin-bottom:14px;">İndirilebilir Dokümanlar</h2>
        <div style="display:flex;flex-wrap:wrap;gap:12px;">
          {d.downloads.map((dl) => (
            <a href={dl.file} class="btn btn-outline" download>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" />
              </svg>
              {dl.label}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>

  {related.length > 0 && (
    <section class="section alt">
      <div class="container">
        <div class="section-head">
          <h2>Benzer Ürünler</h2>
        </div>
        <div class="grid grid-3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <ChartHydrator />
</BaseLayout>

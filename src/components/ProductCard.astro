---
import type { CollectionEntry } from 'astro:content';

interface Props {
  product: CollectionEntry<'urunler'>;
}

const { product } = Astro.props;
const { title, description, kategori, image } = product.data;
const url = `/urunler/${product.id}`;
---

<article
  class="card"
  data-kategori={kategori}
  data-search={`${title} ${description} ${product.data.standartlar.join(' ')}`.toLocaleLowerCase('tr')}
>
  <a href={url} class="card-img" aria-hidden="true" tabindex="-1">
    {image ? (
      <img src={image} alt={title} loading="lazy" />
    ) : (
      <svg width="54" height="54" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
        <rect x="3" y="8" width="18" height="12" rx="1.5" />
        <path d="M7 8V5.5A1.5 1.5 0 0 1 8.5 4h7A1.5 1.5 0 0 1 17 5.5V8M3 13h18" />
      </svg>
    )}
  </a>
  <div class="card-body">
    <span class="card-cat">{kategori}</span>
    <h3><a href={url}>{title}</a></h3>
    <p>{description}</p>
    <div class="card-meta">
      <a href={url} style="font-weight:600;">Ürünü incele →</a>
    </div>
  </div>
</article>

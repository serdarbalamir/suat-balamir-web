---
interface Props {
  title: string;
}
const { title } = Astro.props;
const url = new URL(Astro.url.pathname, Astro.site).href;
const enc = encodeURIComponent;
---

<div class="share-row">
  <span class="label">Paylaş:</span>
  <a
    class="share-btn"
    href={`https://www.linkedin.com/sharing/share-offsite/?url=${enc(url)}`}
    target="_blank"
    rel="noopener"
    aria-label="LinkedIn'de paylaş"
    title="LinkedIn'de paylaş"
  >
    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.47-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12ZM7.12 20.45H3.56V9h3.56v11.45Z"/></svg>
  </a>
  <a
    class="share-btn"
    href={`https://twitter.com/intent/tweet?url=${enc(url)}&text=${enc(title)}`}
    target="_blank"
    rel="noopener"
    aria-label="X'te paylaş"
    title="X'te paylaş"
  >
    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.4l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93 6.06-6.93Zm-1.29 19.5h2.04L6.49 3.24H4.3l13.3 17.4Z"/></svg>
  </a>
  <a
    class="share-btn"
    href={`https://wa.me/?text=${enc(title + ' ' + url)}`}
    target="_blank"
    rel="noopener"
    aria-label="WhatsApp'ta paylaş"
    title="WhatsApp'ta paylaş"
  >
    <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor"><path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.96-.94 1.16-.17.2-.35.22-.65.07-.3-.15-1.25-.46-2.39-1.47-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.6.14-.14.3-.35.45-.52.15-.18.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51l-.57-.01c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.5 0 1.47 1.07 2.89 1.22 3.09.15.2 2.11 3.22 5.1 4.51.71.31 1.27.49 1.7.63.72.23 1.37.2 1.88.12.58-.09 1.76-.72 2.01-1.41.25-.7.25-1.29.17-1.42-.07-.12-.27-.2-.57-.35Zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.9-9.88a9.83 9.83 0 0 1 9.88 9.9c0 5.44-4.44 9.87-9.89 9.87Zm8.42-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.94L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.89 0-3.18-1.24-6.16-3.47-8.4Z"/></svg>
  </a>
  <button class="share-btn" data-copy-link aria-label="Bağlantıyı kopyala" title="Bağlantıyı kopyala">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
  </button>
</div>

<script>
  document.querySelector('[data-copy-link]')?.addEventListener('click', async (e) => {
    await navigator.clipboard.writeText(window.location.href);
    const btn = e.currentTarget as HTMLElement;
    btn.style.borderColor = 'var(--water-600)';
    btn.style.color = 'var(--water-600)';
    setTimeout(() => { btn.style.borderColor = ''; btn.style.color = ''; }, 1200);
  });
</script>
